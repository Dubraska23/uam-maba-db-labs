{
  "datasets": [
    {
      "name": "2c6cf146",
      "displayName": "price_evolution",
      "queryLines": [
        "WITH ranked_cities AS (\n",
        "  SELECT\n",
        "    town_city,\n",
        "    SUM(total_transactions) AS total_transactions\n",
        "  FROM\n",
        "    workspace.uk_housing.gold_temporal_trends\n",
        "  GROUP BY\n",
        "    town_city\n",
        "  ORDER BY\n",
        "    total_transactions DESC\n",
        "  LIMIT :top_cities\n",
        ")\n",
        "SELECT\n",
        "  CAST(CONCAT(year, '-', LPAD(month, 2, '0'), '-01') AS DATE) AS date_of_transfer,\n",
        "  gtt.town_city,\n",
        "  gtt.total_transactions,\n",
        "  ROUND(gtt.avg_price, 0) AS avg_price,\n",
        "  ROUND(gtt.std_price, 0) AS price_volatility,\n",
        "  ROUND(gtt.total_value, 0) AS total_market_value\n",
        "FROM\n",
        "  workspace.uk_housing.gold_temporal_trends gtt\n",
        "    INNER JOIN ranked_cities rc\n",
        "      ON gtt.town_city = rc.town_city\n",
        "ORDER BY\n",
        "  date_of_transfer;"
      ],
      "parameters": [
        {
          "displayName": "Top ciudades por transacciones",
          "keyword": "top_cities",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "10"
                }
              ]
            }
          }
        }
      ],
      "columns": [
        {
          "displayName": "Precio medio ponderado",
          "description": "Media de precios ponderada por el número de transacciones, representando el precio medio real en las ciudades seleccionadas.",
          "expression": "SUM(`avg_price` * `total_transactions`) / SUM(`total_transactions`)"
        }
      ],
      "catalog": "workspace",
      "schema": "uk_housing"
    },
    {
      "name": "3166b7c4",
      "displayName": "property_type",
      "queryLines": [
        "SELECT \r\n",
        "    property_type_desc,\r\n",
        "    total_transactions,\r\n",
        "    ROUND(total_price, 0) AS total_market_value,\r\n",
        "    ROUND(avg_price, 0) AS avg_price\r\n",
        "FROM workspace.uk_housing.gold_property_analysis\r\n",
        "WHERE town_city = 'LONDON'\r\n",
        "ORDER BY total_transactions DESC;"
      ]
    },
    {
      "name": "5bc62c65",
      "displayName": "price_category",
      "queryLines": [
        "SELECT \r\n",
        "    price_category,\r\n",
        "    total_transactions,\r\n",
        "    ROUND(avg_price, 0) AS avg_price,\r\n",
        "    ROUND(min_price, 0) AS min_price,\r\n",
        "    ROUND(max_price, 0) AS max_price,\r\n",
        "    ROUND((total_transactions * 100.0 / SUM(total_transactions) OVER()), 2) AS percentage_market\r\n",
        "FROM workspace.uk_housing.gold_price_category_analysis\r\n",
        "WHERE town_city = 'LONDON'\r\n",
        "ORDER BY avg_price DESC;"
      ]
    },
    {
      "name": "f1539454",
      "displayName": "district_by_transactions",
      "queryLines": [
        "WITH ranked_districts AS (\r\n",
        "  SELECT\r\n",
        "    district,\r\n",
        "    SUM(total_transactions) AS total_transactions,\r\n",
        "    AVG(avg_price) AS avg_price\r\n",
        "  FROM\r\n",
        "    workspace.uk_housing.gold_district_analysis\r\n",
        "  WHERE town_city = 'LONDON'\r\n",
        "  GROUP BY\r\n",
        "    DISTRICT\r\n",
        "  ORDER BY\r\n",
        "    total_transactions DESC\r\n",
        "  LIMIT :top_districts\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  CAST(CONCAT(year, '-', LPAD(month, 2, '0'), '-01') AS DATE) AS date_of_transfer,\r\n",
        "  gda.district,\r\n",
        "  gda.total_transactions,\r\n",
        "  ROUND(gda.avg_price, 0) AS avg_price,\r\n",
        "  ROUND(gda.min_price, 0) AS min_price,\r\n",
        "  ROUND(gda.max_price, 0) AS max_price\r\n",
        "FROM\r\n",
        "  workspace.uk_housing.gold_district_analysis gda\r\n",
        "    INNER JOIN ranked_districts rd\r\n",
        "      ON gda.district = rd.district\r\n",
        "WHERE gda.town_city = 'LONDON'\r\n",
        "ORDER BY\r\n",
        "  date_of_transfer;"
      ],
      "parameters": [
        {
          "displayName": "top_districts",
          "keyword": "top_districts",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "10"
                }
              ]
            }
          }
        }
      ],
      "columns": [
        {
          "displayName": "Precio medio ponderado",
          "description": "Media de precios ponderada por el número de transacciones, representando el precio medio real en las ciudades seleccionadas.",
          "expression": "SUM(`avg_price` * `total_transactions`) / SUM(`total_transactions`)"
        }
      ]
    },
    {
      "name": "445ff7d5",
      "displayName": "district_by_price",
      "queryLines": [
        "WITH ranked_districts AS (\r\n",
        "  SELECT\r\n",
        "    district,\r\n",
        "    AVG(avg_price) AS avg_price,\r\n",
        "    SUM(total_transactions) AS total_transactions\r\n",
        "  FROM\r\n",
        "    workspace.uk_housing.gold_district_analysis\r\n",
        "  WHERE town_city = 'LONDON' AND total_transactions > 10\r\n",
        "  GROUP BY\r\n",
        "    DISTRICT\r\n",
        "  ORDER BY\r\n",
        "    avg_price DESC\r\n",
        "  LIMIT :top_districts\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  CAST(CONCAT(year, '-', LPAD(month, 2, '0'), '-01') AS DATE) AS date_of_transfer,\r\n",
        "  gda.district,\r\n",
        "  gda.total_transactions,\r\n",
        "  ROUND(gda.avg_price, 0) AS avg_price,\r\n",
        "  ROUND(gda.min_price, 0) AS min_price,\r\n",
        "  ROUND(gda.max_price, 0) AS max_price\r\n",
        "FROM\r\n",
        "  workspace.uk_housing.gold_district_analysis gda\r\n",
        "    INNER JOIN ranked_districts rd\r\n",
        "      ON gda.district = rd.district\r\n",
        "WHERE gda.town_city = 'LONDON'\r\n",
        "ORDER BY\r\n",
        "  date_of_transfer;"
      ],
      "parameters": [
        {
          "displayName": "top_districts",
          "keyword": "top_districts",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "10"
                }
              ]
            }
          }
        }
      ],
      "columns": [
        {
          "displayName": "Precio medio ponderado",
          "description": "Media de precios ponderada por el número de transacciones, representando el precio medio real en las ciudades seleccionadas.",
          "expression": "SUM(`avg_price` * `total_transactions`) / SUM(`total_transactions`)"
        }
      ]
    },
    {
      "name": "e77263e9",
      "displayName": "london_6_month_pred",
      "queryLines": [
        "SELECT date_of_transfer, \r\n",
        "ROUND(predicted_avg_price,1) AS predicted_avg_price, \r\n",
        "ROUND(predicted_avg_price_lower) AS predicted_avg_price_lower, \r\n",
        "ROUND(predicted_avg_price_upper) AS predicted_avg_price_upper\r\n",
        "FROM workspace.uk_housing.london_prices_6_month_pred"
      ]
    }
  ],
